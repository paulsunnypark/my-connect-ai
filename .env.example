# ConnectAI proxy defaults to local Ollama.
CONNECTAI_PROXY_MODE=ollama
CONNECTAI_PROXY_PORT=4000
CONNECTAI_PROXY_OLLAMA_URL=http://127.0.0.1:11434

# To route all requests to OpenRouter, set CONNECTAI_PROXY_MODE=cloud.
# To mix selectively, set CONNECTAI_PROXY_MODE=auto and use the alias below as the model name.
CONNECTAI_PROXY_CLOUD_ALIAS=openrouter-cloud
CONNECTAI_PROXY_CLOUD_MODEL=moonshotai/kimi-k2.6
OPENROUTER_API_KEY=

# Optional OpenRouter metadata.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ConnectAI
